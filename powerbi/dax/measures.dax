// Measures for the Shipments table. Generated by powerbi/tools/build_pbip.py.

// [Inventory] format: #,0
Total Waybills = COUNTROWS(Shipments)

// [Inventory] format: #,0
IN Waybills = CALCULATE(COUNTROWS(Shipments), Shipments[InWarehouse] = TRUE())

// [Inventory] format: #,0
OUT Waybills = CALCULATE(COUNTROWS(Shipments), Shipments[InWarehouse] = FALSE())

// [Inventory] format: 0.0%
% IN = DIVIDE([IN Waybills], [Total Waybills])

// [Inventory] format: #,0
Unmatched Waybills = COUNTROWS(Unmatched) + 0

// [Inventory] format: #,0
No Grade Waybills = CALCULATE(COUNTROWS(Shipments), ISBLANK(Shipments[Grade])) + 0

// [Inventory] format: yyyy-mm-dd hh:nn
Last Status File Date = MAX(Shipments[StatusFileDate])

// [Grade stock] format: #,0
G Total = SUM(Shipments[GQty])

// [Grade stock] format: #,0
G IN = CALCULATE(SUM(Shipments[GQty]), Shipments[InWarehouse] = TRUE())

// [Grade stock] format: #,0
G OUT = CALCULATE(SUM(Shipments[GQty]), Shipments[InWarehouse] = FALSE())

// [Grade stock] format: #,0
G Remaining = [G Total] - [G OUT]

// [Grade stock] format: #,0
L Total = SUM(Shipments[LossQty])

// [Grade stock] format: #,0
L IN = CALCULATE(SUM(Shipments[LossQty]), Shipments[InWarehouse] = TRUE())

// [Grade stock] format: #,0
L OUT = CALCULATE(SUM(Shipments[LossQty]), Shipments[InWarehouse] = FALSE())

// [Grade stock] format: #,0
L Remaining = [L Total] - [L OUT]
