table Shipments
	lineageTag: 09dbc010-7c8f-5e96-a4d6-52f6d8cf9062

	measure 'Total Waybills' = COUNTROWS(Shipments)
		formatString: #,0
		displayFolder: Inventory
		lineageTag: b74c2230-5ef5-53d7-a05e-e5d0aaaa9ad6

	measure 'IN Waybills' = CALCULATE(COUNTROWS(Shipments), Shipments[InWarehouse] = TRUE())
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 3ce7ee1d-92a1-587b-8f96-eeaf498dd36f

	measure 'OUT Waybills' = CALCULATE(COUNTROWS(Shipments), Shipments[InWarehouse] = FALSE())
		formatString: #,0
		displayFolder: Inventory
		lineageTag: d6f9a545-8cbc-5ca8-a9ee-e0a633b22bdd

	measure '% IN' = DIVIDE([IN Waybills], [Total Waybills])
		formatString: 0.0%
		displayFolder: Inventory
		lineageTag: 0d0ef53f-9266-5195-9bee-1677cb3a7215

	measure 'Unmatched Waybills' = COUNTROWS(Unmatched) + 0
		formatString: #,0
		displayFolder: Inventory
		lineageTag: fe9b7956-9ed4-554c-a711-798962960301

	measure 'No Grade Waybills' = CALCULATE(COUNTROWS(Shipments), ISBLANK(Shipments[Grade])) + 0
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 4124515e-72e2-532e-9b33-2118713f2d51

	measure 'Last Status File Date' = MAX(Shipments[StatusFileDate])
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Inventory
		lineageTag: 1ac0d58d-918d-52dc-8bc7-cfce21e05b8d

	measure 'G Total' = SUM(Shipments[GQty])
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: c4426150-00e3-5d10-869a-7529ad92df93

	measure 'G IN' = CALCULATE(SUM(Shipments[GQty]), Shipments[InWarehouse] = TRUE())
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: b293178b-08c6-5ee7-9d8a-f5a6ecb9ae15

	measure 'G OUT' = CALCULATE(SUM(Shipments[GQty]), Shipments[InWarehouse] = FALSE())
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: ec7cf917-7602-5ad6-9c8c-cf63f8bcb1bf

	measure 'G Remaining' = [G Total] - [G OUT]
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: 3d3e4796-113c-5b17-b124-ebc4db816c28

	measure 'L Total' = SUM(Shipments[LossQty])
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: e1054cac-d36c-55cd-8435-f695ad54c793

	measure 'L IN' = CALCULATE(SUM(Shipments[LossQty]), Shipments[InWarehouse] = TRUE())
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: 6f5a4ff1-e28f-5a4f-866f-7eff4a2d99d4

	measure 'L OUT' = CALCULATE(SUM(Shipments[LossQty]), Shipments[InWarehouse] = FALSE())
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: 7dadde2c-1025-526b-8bc5-c248407deead

	measure 'L Remaining' = [L Total] - [L OUT]
		formatString: #,0
		displayFolder: Grade stock
		lineageTag: 29ec4e07-5db5-5ad1-a049-bcf26f16cc51

